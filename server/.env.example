PORT=3000
CORS_ORIGINS=http://localhost:5173
# Set the exact trusted proxy hop count only when deployed behind a known proxy.
TRUST_PROXY_HOPS=0
# Shared per-client limit across chat, summaries, and quiz generation.
AI_RATE_LIMIT_PER_MINUTE=20
# Optional. Keep provider credentials in this server-only file; never use a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Public project identifiers (safe to share with the browser; RLS protects rows).
SUPABASE_URL=
SUPABASE_ANON_KEY=
